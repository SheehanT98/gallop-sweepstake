SHARK_EMAIL=you@example.com
SHARK_PASSWORD='#your-password'
SHARK_REGION=europe
SHARK_DEVICE_DSN=AC000W040920697

# Phone on same Wi-Fi
SHARK_LAN=false
SHARK_APP_PORT=8765
SHARK_TIMEZONE=Europe/London

# Background worker (schedules, history sync, notifications)
SHARK_BACKGROUND_INTERVAL=30

# Live robot position on map
SHARK_ENABLE_RT_MAP=true

# Notifications (optional — pick one or both)
# Telegram: message @BotFather, get token + chat id
# SHARK_TELEGRAM_BOT_TOKEN=123456:ABC...
# SHARK_TELEGRAM_CHAT_ID=123456789
# SHARK_WEBHOOK_URL=https://hooks.slack.com/services/...
