# Supabase — create project and run supabase/migrations/001_foaling_wrapped.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public bucket for background media (create in Supabase Storage)
NEXT_PUBLIC_WRAPPED_MEDIA_BUCKET=wrapped-media

# Farm timezone for foaling time/day facts (IANA)
WRAPPED_TIMEZONE=Europe/Dublin
